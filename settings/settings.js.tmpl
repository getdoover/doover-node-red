/**
 * Node-RED settings for the Doover Node-RED app.
 *
 * This file is a TEMPLATE. The Doover supervisor (pydoover) renders it into
 * `<userDir>/settings.js` at startup, substituting the `__MARKER__` tokens from
 * the app's deployment config. Secrets and per-device values are read from the
 * process environment the supervisor injects (see runner.build_child_env).
 *
 * Do not edit the rendered copy in /data — edit this template (and redeploy).
 */

module.exports = {
    // ---- Runtime / storage -------------------------------------------------
    // flowFile lives in the mapped userDir (/data) so flows persist across
    // container restarts.
    flowFile: __FLOW_FILE__,

    // The credential secret comes from the environment the supervisor sets from
    // app config (shared across a fleet so flow packages decrypt everywhere).
    credentialSecret: process.env.DOOVER_CREDENTIAL_SECRET || false,

    // Retain a single flow-file backup; deploys are versioned cloud-side.
    flowFilePretty: true,

    // ---- HTTP / editor -----------------------------------------------------
    uiPort: __NODE_RED_PORT__,

    // Bind the editor + admin API + HTTP-in nodes to loopback only. There is no
    // adminAuth yet, so an all-interfaces (0.0.0.0) bind would expose the
    // unauthenticated editor — full-deploy / arbitrary-code-execution — to any
    // LAN peer, sibling container, or an inadvertent `-p 1880` publish. The editor
    // Bind the editor on the Doovit's network interfaces for direct LAN access.
    // The device firewall controls reachability; add adminAuth before exposing
    // port 1880 beyond a trusted network.
    uiHost: "0.0.0.0",

    // Admin (editor + admin API) mount point.
    httpAdminRoot: __ADMIN_ROOT__,
    // HTTP-in nodes are served under /api to avoid clashing with the editor.
    httpNodeRoot: "/api",

    // Disable-editor hook: when the app config turns the editor off, the admin
    // UI is not served (flows still run). Driven by the supervisor's env flag.
    disableEditor: (process.env.DOOVER_DISABLE_EDITOR === "true") || __DISABLE_EDITOR__,

    // ---- External modules --------------------------------------------------
    // Allow the pre-installed Doover palette (and any configured extra palette
    // packages) to be managed from the editor's palette manager; block ad-hoc
    // installs otherwise. The SAME allowlist is applied to BOTH the Palette
    // Manager (palette.allowList) and function-node external requires
    // (modules.allowList) — without palette.allowList the Palette Manager would
    // honour no allowlist and could install any public-npm package (supply-chain
    // RCE via install scripts / node load), contradicting the "block ad-hoc
    // installs" intent above.
    externalModules: {
        autoInstall: false,
        palette: {
            allowInstall: true,
            allowUpload: false,
            allowList: __EXTERNAL_MODULES_ALLOWLIST__,
        },
        modules: {
            allowInstall: true,
            allowList: __EXTERNAL_MODULES_ALLOWLIST__,
        },
    },

    // ---- Function nodes ----------------------------------------------------
    // Nothing exposed to function nodes yet; Doover access is via palette nodes.
    functionGlobalContext: {},
    functionExternalModules: true,

    // ---- Logging -----------------------------------------------------------
    logging: {
        console: {
            level: process.env.DOOVER_LOG_LEVEL || "info",
            metrics: false,
            audit: false,
        },
    },

    // ---- Editor theme / misc ----------------------------------------------
    editorTheme: {
        projects: {
            // Flow storage is handled by the Doover channel-backed storage
            // module (later phase); the built-in projects feature stays off.
            enabled: false,
        },
    },
};
