{
  "name": "node-red-contrib-doover",
  "version": "0.1.0",
  "description": "Doover nodes for Node-RED: tags, channels, aggregates and notifications, working both on a Doover device (local gRPC) and against the Doover cloud.",
  "keywords": [
    "node-red",
    "doover"
  ],
  "node-red": {
    "nodes": {
      "doover-connection": "nodes/doover-connection.js",
      "doover-tags": "nodes/tags.js",
      "doover-channels": "nodes/channels.js",
      "doover-notify": "nodes/notify.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "e2e": "node test/e2e/run-e2e.js"
  },
  "dependencies": {
    "@doover/nodered-core": "^0.1.0"
  },
  "devDependencies": {
    "node-red": "^4.0.0",
    "node-red-node-test-helper": "^0.3.4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
