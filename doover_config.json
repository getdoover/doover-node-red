{
    "doover_node_red": {
        "key": "32134bbb-5278-43c0-a6ca-4046a5edeb9f",
        "name": "doover_node_red",
        "display_name": "Node-RED",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": false,
        "description": "Run the Node-RED flow runtime on a Doover device. Wire tags, channels, notifications and hardware I/O into Node-RED flows, and surface them in the Doover UI.",
        "long_description": "README.md",
        "depends_on": [],
        "owner_org_key": "",
        "image_name": "ghcr.io/getdoover/doover-nodered:main",
        "container_registry_profile_key": "",
        "build_args": "--platform linux/amd64,linux/arm64",
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "editor_enabled": {
                    "title": "Editor Enabled",
                    "x-name": "editor_enabled",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Serve the Node-RED flow editor. Disable entirely for locked-down production devices \u2014 flows still run, but the editor is inaccessible.",
                    "default": true,
                    "x-position": 0
                },
                "editor_access": {
                    "enum": [
                        "doover-auth",
                        "local-only"
                    ],
                    "title": "Editor Access",
                    "x-name": "editor_access",
                    "x-hidden": true,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "EXPERIMENTAL / not yet implemented. How the editor is reached. 'doover-auth' exposes it via a Doover tunnel authenticated against Doover; 'local-only' keeps it bound to localhost with no tunnel. Hidden until the editor tunnel lands (currently has no effect).",
                    "default": "doover-auth",
                    "x-position": 1
                },
                "extra_palette_packages": {
                    "title": "Extra Palette Packages",
                    "x-name": "extra_palette_packages",
                    "x-hidden": false,
                    "type": [
                        "array",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Additional npm package names to install at startup (e.g. 'node-red-contrib-modbus'). Installs need connectivity and add boot time.",
                    "default": [],
                    "x-position": 2,
                    "items": {
                        "title": "npm package",
                        "x-name": "npm_package",
                        "x-hidden": false,
                        "type": "string",
                        "x-required": true
                    }
                },
                "flows_sync_enabled": {
                    "title": "Flows Sync Enabled",
                    "x-name": "flows_sync_enabled",
                    "x-hidden": true,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "EXPERIMENTAL / not yet implemented. Persist flows to the channel-backed storage so the cloud holds the canonical copy (history = versioning). Hidden until the storage module ships \u2014 flows currently always use local file storage regardless of this value.",
                    "default": true,
                    "x-position": 3
                },
                "flow_package": {
                    "title": "Flow Package",
                    "x-name": "flow_package",
                    "x-hidden": true,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "EXPERIMENTAL / not yet implemented. Pinned flow package as 'name@version' (or 'latest') for fleet mode. Hidden until the supervisor's fetch/install/load apply-loop ships \u2014 setting it currently only echoes the value to the applied-package status tag; no package is fetched, installed or loaded. Leave blank for dev mode.",
                    "default": "",
                    "x-position": 4
                },
                "credential_secret": {
                    "title": "Credential Secret",
                    "x-name": "credential_secret",
                    "x-hidden": true,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Encryption key for flow credentials. Share across a fleet so a flow package's credentials decrypt on every device. Generated per-device if left blank.",
                    "default": "",
                    "x-position": 5
                },
                "flow_env": {
                    "title": "Flow Environment Variables",
                    "x-name": "flow_env",
                    "x-hidden": false,
                    "type": [
                        "object",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Key/value pairs exposed to flows as environment variables (referenced with ${VAR} in node config) \u2014 per-device values for shared flow packages.",
                    "default": {},
                    "x-position": 6,
                    "properties": {},
                    "additionalElements": true,
                    "required": [],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false
                },
                "memory_limit_mb": {
                    "title": "Memory Limit (MB)",
                    "x-name": "memory_limit_mb",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "V8 heap cap for Node-RED (applied via --max-old-space-size). This bounds the JS old-space heap, NOT total RSS (native buffers/pools are extra) \u2014 for a hard memory cap set an orchestrator/compose mem_limit. The runtime typically uses 120-250 MB RSS.",
                    "default": 256,
                    "x-position": 7,
                    "minimum": 64
                },
                "timezone": {
                    "title": "Timezone",
                    "x-name": "timezone",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "IANA timezone (e.g. 'Australia/Brisbane') for Node-RED scheduling nodes. Defaults to UTC.",
                    "default": "UTC",
                    "x-position": 8
                }
            },
            "additionalElements": true,
            "required": []
        },
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().hidden:boolean:false:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": false,
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "runtime_state": {
                    "name": "runtime_state",
                    "type": "uiVariable",
                    "displayString": "Runtime State",
                    "showActivity": true,
                    "position": 51,
                    "hidden": false,
                    "varType": "string",
                    "currentValue": "$tag.app().runtime_state:string:\"starting\""
                },
                "last_deploy_time": {
                    "name": "last_deploy_time",
                    "type": "uiVariable",
                    "displayString": "Last Deploy",
                    "showActivity": true,
                    "position": 52,
                    "hidden": false,
                    "varType": "string",
                    "currentValue": "$tag.app().last_deploy_time:string:\"never\""
                },
                "memory_mb": {
                    "name": "memory_mb",
                    "type": "uiVariable",
                    "displayString": "Memory (MB)",
                    "showActivity": true,
                    "position": 53,
                    "hidden": false,
                    "varType": "float",
                    "currentValue": "$tag.app().memory_mb:number:0",
                    "decPrecision": 1
                },
                "restart_count": {
                    "name": "restart_count",
                    "type": "uiVariable",
                    "displayString": "Restarts",
                    "showActivity": true,
                    "position": 54,
                    "hidden": false,
                    "varType": "float",
                    "currentValue": "$tag.app().restart_count:number:0"
                },
                "open_editor": {
                    "name": "open_editor",
                    "type": "uiButton",
                    "displayString": "Open Editor",
                    "position": 1,
                    "hidden": false,
                    "currentValue": "$cmds.app().open_editor",
                    "appKey": "$config.app().APP_KEY"
                },
                "node_red": {
                    "name": "node_red",
                    "type": "uiContainer",
                    "displayString": "Node-RED",
                    "showActivity": true,
                    "position": 56,
                    "hidden": false,
                    "children": {}
                }
            }
        }
    }
}